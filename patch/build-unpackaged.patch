diff --git a/dep/vcpkg-overlay-triplets/arm64-windows-static.cmake b/dep/vcpkg-overlay-triplets/arm64-windows-static.cmake
index 5f43308b8..11c5683f4 100644
--- a/dep/vcpkg-overlay-triplets/arm64-windows-static.cmake
+++ b/dep/vcpkg-overlay-triplets/arm64-windows-static.cmake
@@ -1,8 +1,18 @@
-# Same as the official arm64-windows-static triplet
-set(VCPKG_TARGET_ARCHITECTURE arm64)
-set(VCPKG_CRT_LINKAGE static)
-set(VCPKG_LIBRARY_LINKAGE static)
-
-# ...but with explicit platform toolset, so that future toolsets
-# aren't automatically picked up (it defaults to the latest one).
-set(VCPKG_PLATFORM_TOOLSET v145)
+# Same as the official arm64-windows-static triplet
+set(VCPKG_TARGET_ARCHITECTURE arm64)
+set(VCPKG_CRT_LINKAGE static)
+set(VCPKG_LIBRARY_LINKAGE static)
+
+# ...but with the platform toolset chosen explicitly, so the triplet does not
+# silently follow whatever is newest on the machine.
+#
+# LOCAL BUILD ADAPTATION (WindowsTerminal-RTL): upstream pins v145, i.e. Visual
+# Studio 2026 (microsoft/terminal#20225). WT_VCPKG_TOOLSET picks the toolset for
+# a given run; when it is unset the pin is dropped and vcpkg takes the latest one
+# the runner actually has. That keeps this file working on a VS 2022 image (v143)
+# and a VS 2026 one (v145) alike, and matches how src/common.build.pre.props:98
+# chooses PlatformToolset from VisualStudioVersion.
+if(DEFINED ENV{WT_VCPKG_TOOLSET} AND NOT "$ENV{WT_VCPKG_TOOLSET}" STREQUAL "")
+  set(VCPKG_PLATFORM_TOOLSET $ENV{WT_VCPKG_TOOLSET})
+  message(STATUS "wt-rtl: VCPKG_PLATFORM_TOOLSET pinned to $ENV{WT_VCPKG_TOOLSET}")
+endif()
\ No newline at end of file
