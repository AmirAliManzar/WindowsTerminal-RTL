diff --git a/src/common.build.post.props b/src/common.build.post.props
index ec143372f..5dedf4e00 100644
--- a/src/common.build.post.props
+++ b/src/common.build.post.props
@@ -116,4 +116,97 @@
 
   <!-- For C++ projects, bring in the vcpkg targets at the end -->
   <Import Project="$(VcpkgRoot)/scripts/buildsystems/msbuild/vcpkg.targets" Condition="'$(MSBuildProjectExtension)'=='.vcxproj'" />
+
+  <!-- ===================================================================
+       LOCAL BUILD ADAPTATION (WindowsTerminal-RTL)
+
+       One workaround, guarded by a command-line flag so that dropping the flag
+       restores upstream behaviour exactly. It does not touch terminal code.
+
+       Do NOT disable the Store toolchain to get an unpackaged binary.
+       WindowsTerminal.vcxproj already sets ApplicationType="Windows Store",
+       WindowsStoreApp=true, WindowsAppContainer=false, _NoWinAPIFamilyApp=true and
+       _VC_Target_Library_Platform=Desktop, and cppwinrt.build.pre.props says what
+       that means: "we're not building a true universal app, we're building a
+       desktop application with xaml". The Store build is what makes the XAML
+       compiler, GeneratedFilesDir, the UAP platform winmds and the include paths
+       for the generated XAML sources all resolve. Passing -p:WindowsStoreApp=false
+       or -p:ApplicationType= sets a *global* property, which beats the value in
+       the project, and every one of those then has to be re-created by hand.
+
+       The exception is MakePri.exe: this machine's Windows SDK has no
+       References\10.0.26100.0\Windows.props and Platforms\, and winsdksetup.exe
+       refuses to repair an SDK it already believes is installed (exit 1001), so
+       the probe for MakePri - a tool only the PRI/MSIX pipeline needs - fails with
+       APPX3217 / MSB4044 "MakePriExeFullPath". Supply the path and skip the probe.
+       MSBuild keeps the last definition of a target name, and this file is
+       imported after the Appx targets, so ours wins.
+
+       The path is the HOST's MakePri, not the target's. A resource index maps
+        resource paths to files and carries an architecture qualifier as data; it
+        contains no code, so the machine that writes it does not constrain what it
+        may contain. The SDK ships makepri.exe per architecture and the ARM64 one
+        cannot be executed on x64, so asking for $(Platform)'s copy fails as soon
+        as ARM64 is cross-compiled:
+
+          error MSB6003: The specified task executable "MakePri.exe" could not be
+          run. The specified executable is not a valid application for this OS
+          platform.
+
+        MakePriArchitecture stays $(Platform): that one is the qualifier recorded
+        in the index, and it does have to be the target's.
+       =================================================================== -->
+  <Target Name="_GetSdkToolsPathsFromSdk"
+          Condition="'$(LocalBuildSkipAppxSdkToolProbe)'=='true'">
+    <PropertyGroup>
+      <!-- PROCESSOR_ARCHITECTURE is an environment property MSBuild exposes, and
+           the names are the SDK's directory names once translated, which is why
+           AMD64 maps to x64 rather than to itself. -->
+      <_MakePriHostDir Condition="'$(_MakePriHostDir)'=='' And ('$(PROCESSOR_ARCHITECTURE)'=='AMD64' Or '$(PROCESSOR_ARCHITECTURE)'=='x64')">x64</_MakePriHostDir>
+      <_MakePriHostDir Condition="'$(_MakePriHostDir)'=='' And '$(PROCESSOR_ARCHITECTURE)'=='ARM64'">arm64</_MakePriHostDir>
+      <_MakePriHostDir Condition="'$(_MakePriHostDir)'=='' And '$(PROCESSOR_ARCHITECTURE)'=='x86'">x86</_MakePriHostDir>
+      <_MakePriHostDir Condition="'$(_MakePriHostDir)'==''">$(Platform)</_MakePriHostDir>
+      <MakePriExeFullPath Condition="'$(MakePriExeFullPath)'==''">$(WindowsSdkDir)bin\10.0.26100.0\$(_MakePriHostDir)\makepri.exe</MakePriExeFullPath>
+      <MakePriArchitecture Condition="'$(MakePriArchitecture)'==''">$(Platform)</MakePriArchitecture>
+    </PropertyGroup>
+  </Target>
+
+  <Target Name="_GetAppxManifestSchemaItemsFromSdk"
+          Condition="'$(LocalBuildSkipAppxSdkToolProbe)'=='true'" />
+
+
+
+<!-- (2b) Explicit link/lib target machine.
+       The Store platform props that normally pin %(Link.TargetMachine) live at
+         VC\v170\Application Type\Windows Store\10.0\Platforms\<arch>\
+       and are reached through $(_PlatformFolder). For a project that sets
+       OpenConsoleUniversalApp=true (so AppContainerApplication=true), that chain
+       does not resolve here and the machine type is never set, which shows up as
+       "warning LNK4068: /MACHINE not specified; defaulting to X86" followed by
+       "fatal error LNK1112: module machine type 'x64' conflicts with target
+       machine type 'x86'" on the first x64 object.
+
+       Same '== ''' guard the SDK's own Platform.Common.props uses, so if it ever
+       does resolve, this stays inert. -->
+  <PropertyGroup Condition="'$(LocalBuildExplicitTargetMachine)'=='true'">
+    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='x64'">MachineX64</_LocalTargetMachine>
+    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='ARM64'">MachineARM64</_LocalTargetMachine>
+    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='ARM'">MachineARM</_LocalTargetMachine>
+    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='Win32'">MachineX86</_LocalTargetMachine>
+  </PropertyGroup>
+
+  <ItemDefinitionGroup Condition="'$(LocalBuildExplicitTargetMachine)'=='true'">
+    <Link Condition="'$(_LocalTargetMachine)'!=''">
+      <TargetMachine Condition="'%(TargetMachine)'==''">$(_LocalTargetMachine)</TargetMachine>
+    </Link>
+    <Lib Condition="'$(_LocalTargetMachine)'!=''">
+      <TargetMachine Condition="'%(TargetMachine)'==''">$(_LocalTargetMachine)</TargetMachine>
+    </Lib>
+    <ImpLib Condition="'$(_LocalTargetMachine)'!=''">
+      <TargetMachine Condition="'%(TargetMachine)'==''">$(_LocalTargetMachine)</TargetMachine>
+    </ImpLib>
+  </ItemDefinitionGroup>
+
+
+
 </Project>
diff --git a/src/common.build.pre.props b/src/common.build.pre.props
index b3f57bf23..6891f54d1 100644
--- a/src/common.build.pre.props
+++ b/src/common.build.pre.props
@@ -136,6 +136,17 @@
         C26494: Variable 'index' is uninitialized. Always initialize an object (type. 5).
           This diagnostic is broken in VS 17.7 which our CI currently uses. It's fixed in 17.8.
       -->
+      <!-- LOCAL BUILD ADAPTATION (WindowsTerminal-RTL):
+           MSVC 19.44 (VS 2022 17.14) is newer than the toolset this branch is
+           pinned to and emits diagnostics that the existing upstream code
+           deliberately triggers. /WX then turns them into errors. All are
+           pre-existing upstream code, unrelated to the RTL change:
+             C4706: assignment used as a condition   (TerminalSelection.cpp:269)
+             C4245: signed/unsigned mismatch on `return E_FAIL` (AzureConnection.cpp:457)
+             C4456: a declaration hides a previous local (TextMenuFlyout.cpp)
+             C4458: a declaration hides a class member      (VsSetupConfiguration.h:182)
+           Guarded so upstream behaviour is restored by default. -->
+      <DisableSpecificWarnings Condition="'$(LocalBuildDisableNewerMsvcWarnings)'=='true'">4245;4706;4456;4458;%(DisableSpecificWarnings)</DisableSpecificWarnings>
       <DisableSpecificWarnings>4201;4312;4467;5105;26434;26445;26456;26478;26494;%(DisableSpecificWarnings)</DisableSpecificWarnings>
       <PreprocessorDefinitions>_WINDOWS;EXTERNAL_BUILD;_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
       <SDLCheck>true</SDLCheck>
@@ -267,6 +278,46 @@
   </ItemDefinitionGroup>
 
   <Import Project="$(MSBuildThisFileDirectory)..\build\rules\Branding.targets" />
+  <!-- LOCAL BUILD ADAPTATION (WindowsTerminal-RTL): de-duplicate @(ReferencePath)
+       before the XAML compiler sees it.
+
+       MarkupCompilePass1 passes @(ReferencePath) straight to the XAML compiler as
+       its reference assemblies. In this tree that list contains the same file
+       more than once: a winmd that is named both by an explicit
+       <Reference Include="..."><IsWinMDFile>true</IsWinMDFile> item and by a
+       ProjectReference arrives twice, once with IsWinMDFile set and once
+       without. Microsoft.Terminal.Settings.Editor is the project where this
+       actually bites, because two *different* files there share the assembly
+       simple name Microsoft.Terminal.Control:
+
+         bin\<plat>\<cfg>\Microsoft.Terminal.Control\Microsoft.Terminal.Control.winmd
+         bin\<plat>\<cfg>\Microsoft.Terminal.Control.Lib\Microsoft.Terminal.Control.winmd
+
+       Anything the compiler keys off that name then resolves inconsistently, and
+       the failure surfaces as an internal .NET exception rather than something
+       actionable:
+
+         Microsoft.Windows.UI.Xaml.Common.targets(354,5): Xaml Internal Error
+         error WMC9999: Value cannot be null. Parameter name: name
+
+       Removing the repeats is not observable to the C++ side: KeepDuplicates
+       keeps the original items, so every piece of metadata on the survivors
+       (WinMDFile, LinkLibraryDependencies, ...) is carried over untouched. The
+       set of distinct reference assemblies is exactly what it was.
+
+       Set -p:LocalBuildTrimDuplicateRefs=false to get upstream's behaviour back. -->
+  <Target Name="LocalBuildTrimDuplicateReferencePaths"
+          BeforeTargets="MarkupCompilePass1"
+          Condition="'$(LocalBuildTrimDuplicateRefs)'!='false'">
+    <ItemGroup>
+      <_LocalBuildUniqueRef Include="@(ReferencePath)" KeepDuplicates="false" />
+    </ItemGroup>
+    <ItemGroup Condition="'@(ReferencePath)'!=''">
+      <ReferencePath Remove="@(ReferencePath)" />
+      <ReferencePath Include="@(_LocalBuildUniqueRef)" />
+    </ItemGroup>
+  </Target>
+
 
   <PropertyGroup Label="vcpkg">
     <VcpkgEnableManifest>true</VcpkgEnableManifest>
@@ -280,6 +331,13 @@
 
     <VcpkgAdditionalInstallOptions>--x-feature=terminal</VcpkgAdditionalInstallOptions>
     <VcpkgAdditionalInstallOptions Condition="'$(Configuration)'=='Fuzzing'">$(VcpkgAdditionalInstallOptions) --overlay-triplets=$(SolutionDir)\dep\vcpkg-overlay-triplets\fuzzing</VcpkgAdditionalInstallOptions>
+    <!-- LOCAL BUILD ADAPTATION (WindowsTerminal-RTL): the plain static triplets
+         this project adds next to the fuzzing ones. Without this line vcpkg
+         resolves x64-windows-static to its own built-in triplet and builds the
+         dependencies with whatever toolset is newest on the machine, which is
+         newer than the v143 pinned above; linking a v143 terminal against
+         dependencies built with a different toolset is not reliable. -->
+    <VcpkgAdditionalInstallOptions>$(VcpkgAdditionalInstallOptions) --overlay-triplets=$(SolutionDir)\dep\vcpkg-overlay-triplets</VcpkgAdditionalInstallOptions>
     <!--
       Since we link everything statically, we don't need to copy anything.
       This saves running a powershell script for every project.
