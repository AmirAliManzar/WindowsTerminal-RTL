+
+// Reorders a finished row's glyph arrays from logical to visual order.
+//
+// Why this is sufficient: both backends advance `baselineX` by summing
+// `glyphAdvances` in array order (BackendD2D.cpp:306, BackendD3D.cpp:1203) and
+// never look up a per-glyph X. So permuting the parallel arrays into visual
+// order places every glyph correctly, with no backend change required. The row
+// keeps its exact width because each cluster's advance was already forced to
+// (colEnd - colBeg) * cellSize.x during shaping.
+void AtlasEngine::_applyBidiVisualOrder(ShapedRow& row, const u16 y) noexcept
+{
+    // Fast path: no cluster at all, or nothing RTL. Touch nothing. This keeps
+    // the stock behaviour bit-for-bit identical for LTR-only content.
+    if (row.clusters.empty())
+    {
+        return;
+    }
+
+    // LOCAL BUILD ADAPTATION (WindowsTerminal-RTL): word order. See
+    // BidiUnicodeWordOrder at the top of this file. When it is false, rule L2 below
+    // is skipped and the glyphs inside an RTL cluster are emitted in the order
+    // DirectWrite produced them, because _mapComplex has then asked for left to
+    // right placements and reversing them would put every letter in the wrong
+    // cell.
+    static constexpr bool unicodeWordOrder = BidiUnicodeWordOrder;
+
+    // Find the true maximum level and whether anything is RTL at all.
+    u8 maxLevel = 0;
+    bool hasOdd = false;
+    for (const auto& c : row.clusters)
+    {
+        maxLevel = std::max(maxLevel, c.level);
+        hasOdd = hasOdd || ((c.level & 1) != 0);
+    }
+    if (!hasOdd)
+    {
+        row.clusters.clear();
+        return;
+    }
+
+    // Keep the font each cluster came from. We resolve it by walking `mappings`
+    // (which cover the glyph array in contiguous, ascending ranges) *after*
+    // shaping, because _mapRegularText only appends/coalesces mappings once
+    // _mapComplex has returned.
+    struct ClusterWithFont
+    {
+        u32 glyphsFrom;
+        u32 glyphsTo;
+        u16 colBeg;
+        u16 colEnd;
+        u8 level;
+        IDWriteFontFace2* fontFace; // raw; borrowed from the original mappings
+    };
+    auto sized = std::vector<ClusterWithFont>{};
+    sized.reserve(row.clusters.size());
+
+    u8 minOdd = 0xff;
+    for (const auto& c : row.clusters)
+    {
+        if (c.level & 1)
+        {
+            minOdd = std::min(minOdd, c.level);
+        }
+        IDWriteFontFace2* face = nullptr;
+        for (const auto& m : row.mappings)
+        {
+            if (c.glyphsFrom >= m.glyphsFrom && c.glyphsFrom < m.glyphsTo)
+            {
+                face = m.fontFace.get();
+                break;
+            }
+        }
+        sized.push_back(ClusterWithFont{ c.glyphsFrom, c.glyphsTo, c.colBeg, c.colEnd, c.level, face });
+    }
+
+    // Unicode bidi rule L2: from the highest level down to the lowest odd one,
+    // reverse every contiguous sequence of clusters at or above that level.
+    // For "hello سلام" this flips only the Persian segment; for a fully Persian
+    // line it flips the whole line.
+    //
+    // This is correct *because* IDWriteTextAnalyzer::GetGlyphs hands back the
+    // glyphs of an RTL run in logical order (the same behaviour that made Zed's
+    // gpui_windows renderer mirror RTL words, and what upstream's own
+    // AtlasEngine bidi PR #20156 observed). Reversing the cluster sequence and
+    // then emitting the glyphs by cluster therefore yields visual order.
+    // Set this to false if a future DirectWrite ever changes that contract, in
+    // which case only whole runs should be swapped, not reversed internally.
+    static constexpr bool reverseWithinSameLevelRun = true;
+
+    // Rule L2 itself. Skipped by default - see the note at the top of this
+    // function - so the words keep the order they were typed in while the glyphs
+    // inside each RTL cluster are still emitted back to front, which is what makes
+    // the letters of a word join correctly.
+    if (unicodeWordOrder)
+    {
+        for (u32 level = maxLevel; level >= minOdd; --level)
+        {
+            size_t i = 0;
+            while (i < sized.size())
+            {
+                if (sized[i].level >= level)
+                {
+                    size_t j = i;
+                    while (j < sized.size() && sized[j].level >= level)
+                    {
+                        ++j;
+                    }
+
+                    if (reverseWithinSameLevelRun)
+                    {
+                        std::reverse(sized.begin() + i, sized.begin() + j);
+                    }
+                    else
+                    {
+                        // Reverse the order of maximal equal-level runs, but leave the
+                        // clusters inside each run in the order DirectWrite produced.
+                        size_t a = i;
+                        while (a < j)
+                        {
+                            size_t b = a;
+                            while (b < j && sized[b].level == sized[a].level)
+                            {
+                                ++b;
+                            }
+                            std::reverse(sized.begin() + a, sized.begin() + b);
+                            a = b;
+                        }
+                    }
+
+                    i = j;
+                }
+                else
+                {
+                    ++i;
+                }
+            }
+        }
+    }
+
+    // Emit the glyph arrays in visual order, rebuilding `mappings` on the way.
+    // Adjacent clusters using the same font are coalesced, exactly like
+    // _mapRegularText does. Interleaved fonts just produce more ranges, which
+    // is still correct - only slightly less efficient.
+    auto newIndices = std::vector<u16>{};
+    auto newAdvances = std::vector<f32>{};
+    auto newOffsets = std::vector<DWRITE_GLYPH_OFFSET>{};
+    auto newColors = std::vector<u32>{};
+    auto newMappings = std::vector<FontMapping>{};
+    newIndices.reserve(row.glyphIndices.size());
+    newAdvances.reserve(row.glyphAdvances.size());
+    newOffsets.reserve(row.glyphOffsets.size());
+    newColors.reserve(row.colors.size());
+    newMappings.reserve(row.mappings.size());
+
+    const auto width = static_cast<size_t>(std::max<til::CoordType>(_p.s->viewportCellCount.x, 0));
+    // Start from the identity so columns no cluster covered keep their position.
+    row.columnToVisual.assign(width, 0);
+    for (size_t col = 0; col < width; ++col)
+    {
+        row.columnToVisual[col] = gsl::narrow_cast<u16>(col);
+    }
+
+    // `visualCol` walks the row left to right as we emit, so we learn where each
+    // logical column ended up.
+    u16 visualCol = sized.empty() ? 0 : static_cast<u16>(std::min(static_cast<size_t>(sized.front().colBeg), width));
+
+    for (const auto& c : sized)
+    {
+        const auto from = gsl::narrow_cast<u32>(newIndices.size());
+        if (c.level & 1 && unicodeWordOrder)
+        {
+            // A cluster at an odd level runs right to left, and DirectWrite hands
+            // its glyphs back in logical order, so they have to be emitted back to
+            // front. Only when the cluster order was reversed too: if the words
+            // keep their typed order then _mapComplex has asked for left to right
+            // placements, and reversing here would put every letter in the wrong
+            // cell.
+            for (auto g = c.glyphsTo; g > c.glyphsFrom; --g)
+            {
+                const auto i = g - 1;
+                newIndices.push_back(row.glyphIndices[i]);
+                newAdvances.push_back(row.glyphAdvances[i]);
+                newOffsets.push_back(row.glyphOffsets[i]);
+                newColors.push_back(row.colors[i]);
+            }
+        }
+        else
+        {
+            newIndices.insert(newIndices.end(), row.glyphIndices.begin() + c.glyphsFrom, row.glyphIndices.begin() + c.glyphsTo);
+            newAdvances.insert(newAdvances.end(), row.glyphAdvances.begin() + c.glyphsFrom, row.glyphAdvances.begin() + c.glyphsTo);
+            newOffsets.insert(newOffsets.end(), row.glyphOffsets.begin() + c.glyphsFrom, row.glyphOffsets.begin() + c.glyphsTo);
+            newColors.insert(newColors.end(), row.colors.begin() + c.glyphsFrom, row.colors.begin() + c.glyphsTo);
+        }
+
+        if (newMappings.empty() || newMappings.back().fontFace.get() != c.fontFace)
+        {
+            newMappings.emplace_back(c.fontFace, from, gsl::narrow_cast<u32>(newIndices.size()));
+        }
+        else
+        {
+            newMappings.back().glyphsTo = gsl::narrow_cast<u32>(newIndices.size());
+        }
+
+        // Record the visual position of every logical column of this cluster.
+        const auto beg = std::min(static_cast<size_t>(c.colBeg), width);
+        const auto end = std::min(static_cast<size_t>(c.colEnd), width);
+        for (size_t col = beg; col < end; ++col)
+        {
+            row.columnToVisual[col] = visualCol++;
+        }
+    }
+
+    // The colour planes are indexed by *column*, and the selection/search
+    // highlights were painted into them using logical column arithmetic. Move
+    // them into visual space too, otherwise the highlight would end up under
+    // the wrong cells. (_flushBufferLine runs before Backend*::Render, which is
+    // where _drawBackground samples these, so this is early enough.)
+    {
+        const auto shift = gsl::narrow_cast<u8>(row.lineRendition != LineRendition::SingleWidth);
+        const auto rowOffset = static_cast<size_t>(_p.colorBitmapRowStride) * y;
+        const auto cells = static_cast<size_t>(width) << shift;
+        if (rowOffset + cells <= _p.colorBitmapDepthStride)
+        {
+            // Only touch the planes (and invalidate the GPU copy) if the row
+            // actually moved anything.
+            bool permuted = false;
+            for (size_t col = 0; col < width && !permuted; ++col)
+            {
+                permuted = static_cast<size_t>(row.columnToVisual[col]) != col;
+            }
+
+            if (permuted)
+            {
+                u32* const planes[3] = { _p.backgroundBitmap.data(), _p.foregroundBitmap.data(), _p.underlineBitmap.data() };
+                auto scratch = std::vector<u32>(cells);
+                for (u32* const plane : planes)
+                {
+                    auto* p = plane + rowOffset;
+                    std::copy_n(p, cells, scratch.begin());
+                    for (size_t col = 0; col < cells; ++col)
+                    {
+                        const auto visual = static_cast<size_t>(row.columnToVisual[col >> shift]) << shift;
+                        p[visual] = scratch[col];
+                    }
+                }
+
+                // The backends skip re-uploading the colour planes when the
+                // generation counter has not changed, so it must be bumped here
+                // or they would keep drawing the pre-permutation image.
+                for (auto& generation : _p.colorBitmapGenerations)
+                {
+                    generation.bump();
+                }
+            }
+        }
+    }
+
+    row.glyphIndices = std::move(newIndices);
+    row.glyphAdvances = std::move(newAdvances);
+    row.glyphOffsets = std::move(newOffsets);
+    row.colors = std::move(newColors);
+    row.mappings = std::move(newMappings);
+    row.clusters.clear();
+    row.hasBidi = true;
 }
 
