<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Natvis Include="$(SolutionDir)tools\ConsoleTypes.natvis" />
  </ItemGroup>

  <!--
    The Hybrid CRT model statically links the runtime and STL and dynamically
    links the UCRT instead of the VC++ CRT. The UCRT ships with Windows.
    WinAppSDK asserts that this is "supported according to the CRT maintainer."

    This must come before Microsoft.Cpp.targets because it manipulates ClCompile.RuntimeLibrary.
  -->
  <ItemDefinitionGroup Condition="'$(EnableHybridCRT)'=='true' and '$(Configuration)'=='Debug'">
    <ClCompile>
      <!-- We use MultiThreadedDebug, rather than MultiThreadedDebugDLL, to avoid DLL dependencies on VCRUNTIME140d.dll and MSVCP140d.dll. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- Link statically against the runtime and STL, but link dynamically against the CRT by ignoring the static CRT
           lib and instead linking against the Universal CRT DLL import library. This "hybrid" linking mechanism is
           supported according to the CRT maintainer. Dynamic linking against the CRT makes the binaries a bit smaller
           than they would otherwise be if the CRT, runtime, and STL were all statically linked in. -->
      <IgnoreSpecificDefaultLibraries>%(IgnoreSpecificDefaultLibraries);libucrtd.lib</IgnoreSpecificDefaultLibraries>
      <AdditionalOptions>%(AdditionalOptions) /defaultlib:ucrtd.lib</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EnableHybridCRT)'=='true' and ('$(Configuration)'=='Release' or '$(Configuration)'=='AuditMode')">
    <ClCompile>
      <!-- We use MultiThreaded, rather than MultiThreadedDLL, to avoid DLL dependencies on VCRUNTIME140.dll and MSVCP140.dll. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!-- Link statically against the runtime and STL, but link dynamically against the CRT by ignoring the static CRT
           lib and instead linking against the Universal CRT DLL import library. This "hybrid" linking mechanism is
           supported according to the CRT maintainer. Dynamic linking against the CRT makes the binaries a bit smaller
           than they would otherwise be if the CRT, runtime, and STL were all statically linked in. -->
      <IgnoreSpecificDefaultLibraries>%(IgnoreSpecificDefaultLibraries);libucrt.lib</IgnoreSpecificDefaultLibraries>
      <AdditionalOptions>%(AdditionalOptions) /defaultlib:ucrt.lib</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <!-- Definition the program database type has to come after Microsoft.Cpp.props or it will be
         rewritten to /ZI (edit-and-continue) type every time. -->
    <ClCompile>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <AdditionalDependencies>onecoreuap_apiset.lib;d3dcompiler.lib;dwmapi.lib;uxtheme.lib;shlwapi.lib;ntdll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- DLLs Only -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'DynamicLibrary'">
    <ClCompile>
      <PreprocessorDefinitions>_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Static Libs Only -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'StaticLibrary'">
    <ClCompile>
      <PreprocessorDefinitions>_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Exclude our dependencies from static analysis. CAExcludePath can only be
       set after we've imported Microsoft.Cpp.targets -->
  <PropertyGroup>
    <CAExcludePath>$(SolutionDir)\dep\;$(CAExcludePath)</CAExcludePath>
  </PropertyGroup>

  <Target Name="_ComputePrecompToCleanUp">
    <ItemGroup>
      <PCHFileToClean Include="$(IntDir)\**\*.pch" />
      <PCHFileToClean Include="$(IntDir)\**\precomp.obj" />
      <_PCHFileToCleanWithTimestamp Include="@(PCHFileToClean)" Condition="'%(Identity)' != ''">
        <LastWriteTime>$([System.IO.File]::GetLastWriteTime('%(Identity)'))</LastWriteTime>
      </_PCHFileToCleanWithTimestamp>
    </ItemGroup>
  </Target>
  <!-- Instead of outright deleting the PCHs, we want to trick the "project freshness detector" by
       emitting empty files that look suspiciously like the PCHs it's expecting.
       It's of utmost importance that their timestamps match up. -->
  <Target Name="CleanUpPrecompForSmallCIAgents"
          DependsOnTargets="_ComputePrecompToCleanUp"
          AfterTargets="AfterBuild"
          Condition="'$(OpenConsoleCleanPCH)' == 'true' and '$(AGENT_ID)' != '' and !$(ProjectName.Contains('TerminalApp'))">
    <!-- We just need to keep *TerminalApp*'s PCHs because they get rebuilt more often. -->
    <Delete Files="@(_PCHFileToCleanWithTimestamp)"/>
    <Touch Files="@(_PCHFileToCleanWithTimestamp)" Time="%(LastWriteTime)" AlwaysCreate="true" />
    <Message Text="PCH and Precomp object @(_PCHFileToCleanWithTimestamp) has been deleted for $(ProjectName)." />
  </Target>

  <PropertyGroup>
    <BuildDependsOn>
      OCCallFeatureFlagGenerator;
      $(BuildDependsOn)
    </BuildDependsOn>
  </PropertyGroup>

  <Target Name="OCCallFeatureFlagGenerator">
    <MSBuild Projects="$(SolutionDir)\build\rules\GenerateFeatureFlags.proj" />
  </Target>

  <ItemDefinitionGroup>
    <ClCompile>
      <ForcedIncludeFiles>$(SolutionDir)\bin\$(Configuration)\inc\TilFeatureStaging.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- For C++ projects, bring in the vcpkg targets at the end -->
  <Import Project="$(VcpkgRoot)/scripts/buildsystems/msbuild/vcpkg.targets" Condition="'$(MSBuildProjectExtension)'=='.vcxproj'" />

  <!-- ===================================================================
       LOCAL BUILD ADAPTATION (WindowsTerminal-RTL)

       One workaround, guarded by a command-line flag so that dropping the flag
       restores upstream behaviour exactly. It does not touch terminal code.

       Do NOT disable the Store toolchain to get an unpackaged binary.
       WindowsTerminal.vcxproj already sets ApplicationType="Windows Store",
       WindowsStoreApp=true, WindowsAppContainer=false, _NoWinAPIFamilyApp=true and
       _VC_Target_Library_Platform=Desktop, and cppwinrt.build.pre.props says what
       that means: "we're not building a true universal app, we're building a
       desktop application with xaml". The Store build is what makes the XAML
       compiler, GeneratedFilesDir, the UAP platform winmds and the include paths
       for the generated XAML sources all resolve. Passing -p:WindowsStoreApp=false
       or -p:ApplicationType= sets a *global* property, which beats the value in
       the project, and every one of those then has to be re-created by hand.

       The exception is MakePri.exe: this machine's Windows SDK has no
       References\10.0.26100.0\Windows.props and Platforms\, and winsdksetup.exe
       refuses to repair an SDK it already believes is installed (exit 1001), so
       the probe for MakePri - a tool only the PRI/MSIX pipeline needs - fails with
       APPX3217 / MSB4044 "MakePriExeFullPath". Supply the path and skip the probe.
       MSBuild keeps the last definition of a target name, and this file is
       imported after the Appx targets, so ours wins.

       The path is the HOST's MakePri, not the target's. A resource index maps
        resource paths to files and carries an architecture qualifier as data; it
        contains no code, so the machine that writes it does not constrain what it
        may contain. The SDK ships makepri.exe per architecture and the ARM64 one
        cannot be executed on x64, so asking for $(Platform)'s copy fails as soon
        as ARM64 is cross-compiled:

          error MSB6003: The specified task executable "MakePri.exe" could not be
          run. The specified executable is not a valid application for this OS
          platform.

        MakePriArchitecture stays $(Platform): that one is the qualifier recorded
        in the index, and it does have to be the target's.
       =================================================================== -->
  <Target Name="_GetSdkToolsPathsFromSdk"
          Condition="'$(LocalBuildSkipAppxSdkToolProbe)'=='true'">
    <PropertyGroup>
      <!-- PROCESSOR_ARCHITECTURE is an environment property MSBuild exposes, and
           the names are the SDK's directory names once translated, which is why
           AMD64 maps to x64 rather than to itself. -->
      <_MakePriHostDir Condition="'$(_MakePriHostDir)'=='' And ('$(PROCESSOR_ARCHITECTURE)'=='AMD64' Or '$(PROCESSOR_ARCHITECTURE)'=='x64')">x64</_MakePriHostDir>
      <_MakePriHostDir Condition="'$(_MakePriHostDir)'=='' And '$(PROCESSOR_ARCHITECTURE)'=='ARM64'">arm64</_MakePriHostDir>
      <_MakePriHostDir Condition="'$(_MakePriHostDir)'=='' And '$(PROCESSOR_ARCHITECTURE)'=='x86'">x86</_MakePriHostDir>
      <_MakePriHostDir Condition="'$(_MakePriHostDir)'==''">$(Platform)</_MakePriHostDir>
      <MakePriExeFullPath Condition="'$(MakePriExeFullPath)'==''">$(WindowsSdkDir)bin\10.0.26100.0\$(_MakePriHostDir)\makepri.exe</MakePriExeFullPath>
      <MakePriArchitecture Condition="'$(MakePriArchitecture)'==''">$(Platform)</MakePriArchitecture>
    </PropertyGroup>
  </Target>

  <Target Name="_GetAppxManifestSchemaItemsFromSdk"
          Condition="'$(LocalBuildSkipAppxSdkToolProbe)'=='true'" />



<!-- (2b) Explicit link/lib target machine.
       The Store platform props that normally pin %(Link.TargetMachine) live at
         VC\v170\Application Type\Windows Store\10.0\Platforms\<arch>\
       and are reached through $(_PlatformFolder). For a project that sets
       OpenConsoleUniversalApp=true (so AppContainerApplication=true), that chain
       does not resolve here and the machine type is never set, which shows up as
       "warning LNK4068: /MACHINE not specified; defaulting to X86" followed by
       "fatal error LNK1112: module machine type 'x64' conflicts with target
       machine type 'x86'" on the first x64 object.

       Same '== ''' guard the SDK's own Platform.Common.props uses, so if it ever
       does resolve, this stays inert. -->
  <PropertyGroup Condition="'$(LocalBuildExplicitTargetMachine)'=='true'">
    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='x64'">MachineX64</_LocalTargetMachine>
    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='ARM64'">MachineARM64</_LocalTargetMachine>
    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='ARM'">MachineARM</_LocalTargetMachine>
    <_LocalTargetMachine Condition="'$(_LocalTargetMachine)'=='' And '$(Platform)'=='Win32'">MachineX86</_LocalTargetMachine>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(LocalBuildExplicitTargetMachine)'=='true'">
    <Link Condition="'$(_LocalTargetMachine)'!=''">
      <TargetMachine Condition="'%(TargetMachine)'==''">$(_LocalTargetMachine)</TargetMachine>
    </Link>
    <Lib Condition="'$(_LocalTargetMachine)'!=''">
      <TargetMachine Condition="'%(TargetMachine)'==''">$(_LocalTargetMachine)</TargetMachine>
    </Lib>
    <ImpLib Condition="'$(_LocalTargetMachine)'!=''">
      <TargetMachine Condition="'%(TargetMachine)'==''">$(_LocalTargetMachine)</TargetMachine>
    </ImpLib>
  </ItemDefinitionGroup>



</Project>
