<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  WindowsTerminal-RTL portable launcher manifest.

  The launcher writes only into %LOCALAPPDATA% and never registers anything
  machine-wide, so it stays at asInvoker: no UAC prompt, no admin needed. This
  matches the installer and is what makes the portable build safe to run from
  any folder.

  comctl 6 keeps the standard controls on the modern visual style, and declaring
  the supported Windows 10 versions keeps Environment.OSVersion and the version
  helpers from reporting a compatibility view.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.0.7.0" name="WindowsTerminal.RTL.Portable"
    type="win32"/>
  <description>Windows Terminal RTL portable launcher</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
</assembly>
